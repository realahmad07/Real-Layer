# Required node identity and network settings
GHOST_NODE_ID=replace-with-a-local-node-id
GHOST_LISTEN_ADDRESS=/ip4/127.0.0.1/udp/7000/quic-v1
GHOST_ADVERTISED_ADDRESS=/ip4/127.0.0.1/udp/7000/quic-v1
GHOST_NETWORK_ENVIRONMENT=development
GHOST_RELAY_ROLE=both
GHOST_LOG_LEVEL=info
GHOST_IDENTITY_PATH=./ghost-layer.key
GHOST_BOOTSTRAP_PEERS=
GHOST_CONNECTION_TIMEOUT_SECS=10
GHOST_HEALTH_LISTEN_ADDRESS=127.0.0.1:8080

# Relay operational state and health settings
GHOST_HEARTBEAT_INTERVAL_SECS=10
GHOST_HEARTBEAT_FRESHNESS_SECS=30
GHOST_DEGRADED_LATENCY_MS=500
GHOST_SOFTWARE_VERSION=0.1.0
GHOST_PROTOCOL_VERSION=1.0
GHOST_DISCOVERY_REQUIRED_TRANSPORT=quic
GHOST_DISCOVERY_REQUIRED_CAPABILITIES=relay
GHOST_ROUTE_MODE=one-hop

# Controlled exit policy. Use exact IP:PORT values only; leave disabled by default.
GHOST_ALLOWED_EXIT_DESTINATIONS=
GHOST_EXTERNAL_TEST_DESTINATION=
GHOST_UDP_ENABLED=false
GHOST_NAT_ENABLED=false
GHOST_DNS_ENABLED=false
GHOST_DNS_SERVER=

# Public RPC and coordination endpoints. Do not put private keys or tokens here.
GHOST_SOLANA_RPC_URL=https://api.devnet.solana.com
GHOST_MAGICBLOCK_ENDPOINT=
